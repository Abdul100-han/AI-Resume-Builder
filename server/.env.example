# Backend environment. Copy to server/.env and fill in the values.
# Frontend variables belong in the root .env (see ../.env.example).

# --- Server ---
PORT=5000

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# "service_role" secret key. Server only — never put it in the root .env or commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Admin account (created automatically on first start / seed) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123

