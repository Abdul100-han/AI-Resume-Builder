# Frontend environment. Copy to .env in the project root.
# The API reads server/.env instead. Never put Supabase keys here.

# API base URL. Leave empty to use the Vite dev proxy (http://localhost:5000).
VITE_API_BASE_URL=http://localhost:5000
# Google Gemini key for AI-written CV summaries and bullet points (optional).
VITE_GOOGLE_AI_API_KEY=
# Public URL of the frontend, used in shared CV links.
VITE_BASE_URL=http://localhost:5173
# Show the "Demo accounts" switcher outside development (true/false).
VITE_DEMO_MODE=false
